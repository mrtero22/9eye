# Copy to .env (never committed) and set a password.
NINEEYE_DB_PASSWORD=change-me
DATABASE_URL=postgresql://nineeye:change-me@127.0.0.1:5442/nineeye
TEST_DATABASE_URL=postgresql://nineeye:change-me@127.0.0.1:5442/nineeye_test
API_HOST=127.0.0.1
API_PORT=4100
# Company used when a request names none (local development only): a short name from npm run db:seed.
DEV_TENANT=sample-station

# Key for credentials stored in the database (AES-256-GCM): base64 of 32 random bytes.
NINEEYE_SECRET_KEY=change-me-base64-32-bytes
