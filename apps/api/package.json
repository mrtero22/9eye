{
  "name": "@9eye/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "db:generate": "prisma generate",
    "user:create": "tsx --env-file=../../.env scripts/create-user.ts",
    "user:password": "tsx --env-file=../../.env scripts/set-password.ts",
    "token": "tsx --env-file=../../.env scripts/access-token.ts",
    "mcp:stdio": "tsx --env-file=../../.env scripts/mcp-stdio.ts",
    "demo:setup": "tsx --env-file=../../.env scripts/demo-setup.ts",
    "demo:data": "tsx --env-file=../../.env scripts/demo-data.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@9eye/core": "*",
    "@anthropic-ai/sdk": "1.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@prisma/client": "6.19.3",
    "express": "^5.1.0",
    "openai": "7.48.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.0",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
