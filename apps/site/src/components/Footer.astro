---
import { BRAND, FOOTER, TAGLINE } from '../site';
import Mark from './Mark.astro';

const path = Astro.url.pathname.replace(/\.html$/, '') || '/';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="brand" href="/" style="font-size: 18px"><Mark size={24} hole="var(--surface)" />{BRAND}</a>
        <p>{TAGLINE}</p>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        {FOOTER.map((col) => (
          <div>
            <h2>{col.title}</h2>
            {col.links.map((l) => <a href={l.href} aria-current={l.href === path ? 'page' : undefined}>{l.label}</a>)}
          </div>
        ))}
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© {year} {BRAND}. All rights reserved.</span>
      <nav aria-label="Legal"><a href="/privacy">Privacy policy</a><a href="/contact">Contact</a></nav>
    </div>
  </div>
</footer>
