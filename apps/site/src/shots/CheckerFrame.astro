---
// The window around a Playlist Checker screenshot (studio case study, /studio/playlist-checker): browser dots, the
// address and the checker's own top bar. Sample data only: fictional channel Northvale One, no client names.
interface Props { label: string; address: string; page?: string; width?: number; height?: number }
const { label, address, page, width = 1200, height = 760 } = Astro.props;
---
<div id="shot" role="img" aria-label={label} style={`width:${width}px;height:${height}px;overflow:hidden;display:flex;flex-direction:column;background:#fafafa;font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;color:#18181b;font-size:13px;line-height:1.4`}>
  <div style="height: 40px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 16px; background: #f4f4f5; border-bottom: 1px solid #e4e4e7">
    <span style="width: 11px; height: 11px; border-radius: 50%; background: #d4d4d8"></span>
    <span style="width: 11px; height: 11px; border-radius: 50%; background: #d4d4d8"></span>
    <span style="width: 11px; height: 11px; border-radius: 50%; background: #d4d4d8"></span>
    <span style="margin-left: 16px; display: inline-flex; align-items: center; height: 26px; width: 420px; padding: 0 12px; border-radius: 999px; background: #fff; border: 1px solid #e4e4e7; color: #6b6b74; font-size: 12px; white-space: nowrap; overflow: hidden">{address}</span>
  </div>
  {page && (
    <div style="height: 52px; flex: none; display: flex; align-items: center; gap: 12px; padding: 0 20px; background: #fff; border-bottom: 1px solid #e4e4e7">
      <span style="width: 26px; height: 26px; border-radius: 7px; background: #0d9488; color: #fff; display: inline-flex; align-items: center; justify-content: center"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg></span>
      <span style="font-weight: 600">Playlist Checker</span>
      <span style="width: 1px; height: 20px; background: #e4e4e7"></span>
      <span style="color: #52525b">{page}</span>
      <span style="flex: 1"></span>
      <span style="display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 12px; border: 1px solid #e4e4e7; border-radius: 6px; color: #18181b; font-weight: 500"><span style="width: 8px; height: 8px; border-radius: 50%; background: #0d9488"></span>Northvale One</span>
      <span style="display: inline-flex; align-items: center; height: 30px; padding: 0 12px; border: 1px solid #e4e4e7; border-radius: 6px; color: #18181b; font-weight: 500">Tue 17 Nov 2026</span>
    </div>
  )}
  <slot />
</div>
