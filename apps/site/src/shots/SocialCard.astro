---
// The 1200 × 630 image shown when a page is shared (og.png). Uses the Templates screenshot.
import { BRAND } from '../site';
---
<div id="shot" style="position: relative; width: 1200px; height: 630px; overflow: hidden; box-sizing: border-box; padding: 64px; background: #fafafa; color: #18181b; font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif">
  <div style="position: relative; z-index: 1; width: 540px; height: 100%; display: flex; flex-direction: column; gap: 28px">
    <span style="display: inline-flex; align-items: center; gap: 12px; font-weight: 600; font-size: 30px; letter-spacing: -0.02em">
      <svg width="36" height="36" viewBox="0 0 24 24"><rect width="24" height="24" rx="7" fill="#18181b"></rect><circle cx="12" cy="12" r="5.75" fill="none" stroke="#fafafa" stroke-width="2.25"></circle><circle cx="12" cy="12" r="2" fill="#fafafa"></circle></svg>{BRAND}
    </span>
    <span style="flex: 1"></span>
    <span style="margin: 0; font-size: 56px; line-height: 1.03; letter-spacing: -0.04em; font-weight: 600">AI agents for broadcast scheduling and TV traffic.</span>
    <span style="display: flex; align-items: center; gap: 16px">
      <span style="display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 14px; border-radius: 999px; background: #eaf1ff; color: #1d4ed8; font-size: 15px; font-weight: 500"><span style="width: 7px; height: 7px; border-radius: 50%; background: #2563eb"></span>Early access</span>
      <span style="font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 15px; color: #6b6b74">Linear · FAST · Streaming</span>
    </span>
  </div>
  <img src="/images/templates.webp" alt="" width="816" height="517" style="position: absolute; left: 640px; top: 96px; width: 816px; height: auto; border-radius: 10px; box-shadow: 0 0 0 1px #e4e4e7, 0 28px 64px -16px rgba(24,24,27,.22)" />
</div>
