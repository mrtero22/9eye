---
// Screenshot: the Templates page — a fictional channel's week of blocks, one block selected.
import ShotFrame from './ShotFrame.astro';

const C: Record<string, string> = { morning: '#0d9488', day: '#64748b', news: '#2563eb', movie: '#d97706', kids: '#7c3aed', ent: '#db2777', prime: '#ea580c', sport: '#16a34a', night: '#71717a' };
type B = [string, number, number, string];
const weekday: B[] = [
  ['Breakfast Live', 360, 540, 'morning'], ['Daytime Drama', 540, 720, 'day'], ['Midday News', 720, 750, 'news'],
  ['Matinee Movie', 750, 900, 'movie'], ['Kids Afternoon', 900, 1080, 'kids'], ['Quiz Hour', 1080, 1140, 'ent'],
  ['News and Weather', 1140, 1200, 'news'], ['Prime Drama', 1200, 1320, 'prime'], ['Late Movie', 1320, 1440, 'movie'],
];
const sat: B[] = [
  ['Kids Morning', 360, 600, 'kids'], ['Weekend Sport', 600, 780, 'sport'], ['Matinee Movie', 780, 960, 'movie'],
  ['Weekend Sport', 960, 1140, 'sport'], ['News and Weather', 1140, 1200, 'news'], ['Saturday Movie', 1200, 1350, 'movie'],
  ['Night Repeats', 1350, 1440, 'night'],
];
const sun: B[] = [
  ['Kids Morning', 360, 600, 'kids'], ['Documentaries', 600, 780, 'day'], ['Family Film', 780, 960, 'movie'],
  ['Quiz Hour', 960, 1020, 'ent'], ['Sunday Magazine', 1020, 1140, 'morning'], ['News and Weather', 1140, 1200, 'news'],
  ['Sunday Drama', 1200, 1320, 'prime'], ['Night Repeats', 1320, 1440, 'night'],
];
const span = 18 * 60;
const hhmm = (m: number) => `${String(Math.floor(m / 60) % 24).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((label, i) => ({
  label, date: String(2 + i),
  blocks: (i < 5 ? weekday : i === 5 ? sat : sun).map(([name, s, e, g]) => ({
    name, time: `${hhmm(s)} – ${hhmm(e)}`, showName: e - s >= 60, showTime: e - s >= 120,
    style: `top:${(((s - 360) / span) * 100).toFixed(3)}%;height:calc(${(((e - s) / span) * 100).toFixed(3)}% - 2px);background:${C[g]}1f;border:1px solid ${C[g]}59;box-shadow:${i === 0 && name === 'Prime Drama' ? '0 0 0 2px #2563eb' : 'none'}`,
  })),
}));
const hours = [6, 8, 10, 12, 14, 16, 18, 20, 22].map((h) => ({ label: `${String(h).padStart(2, '0')}:00`, top: `${(((h - 6) / 18) * 100).toFixed(3)}%` }));
const groups: [string, [string, string, string, boolean?][]][] = [
  ['Morning', [['Breakfast Live', '3 h', 'morning'], ['Kids Morning', '4 h', 'kids']]],
  ['Daytime', [['Daytime Drama', '3 h', 'day'], ['Kids Afternoon', '3 h', 'kids']]],
  ['News', [['Midday News', '30 m', 'news'], ['News and Weather', '1 h', 'news']]],
  ['Prime time', [['Prime Drama', '2 h', 'prime', true], ['Quiz Hour', '1 h', 'ent']]],
  ['Movies', [['Matinee Movie', '2.5 h', 'movie'], ['Late Movie', '2 h', 'movie'], ['Saturday Movie', '2.5 h', 'movie']]],
];
const mono = "font-family:'Geist Mono Variable',ui-monospace,monospace";
const chev = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>';
const dots = '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>';
const close = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>';
---
<ShotFrame active="Templates" label="The Templates page: a channel's week of programme blocks, Monday to Sunday, with one block's details on the right.">
  <div style="flex: none; display: flex; align-items: flex-end; gap: 16px; padding: 20px 24px 16px">
    <div style="display: flex; flex-direction: column; gap: 4px">
      <span style="font-size: 22px; font-weight: 600; letter-spacing: -0.02em">Templates</span>
      <span style="display: flex; align-items: center; gap: 6px; color: #52525b"><span style="font-weight: 500; color: #18181b">Tessa One</span><Fragment set:html={chev} /><span style="color: #a1a1aa">·</span><span>Main playlist</span><Fragment set:html={chev} /><span style="color: #a1a1aa">·</span><span>25 fps · Europe/Lisbon · day starts 06:00</span></span>
    </div>
    <span style="flex: 1"></span>
    <span style="display: inline-flex; align-items: center; height: 32px; padding: 0 12px; border-radius: 6px; border: 1px solid #d4d4d8; background: #fff; font-weight: 500">Repeat a time range</span>
    <span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; color: #52525b" set:html={dots} />
    <span style="display: inline-flex; align-items: center; height: 32px; padding: 0 14px; border-radius: 6px; background: #2563eb; color: #fff; font-weight: 500">Save</span>
  </div>
  <div style="flex: 1; min-height: 0; display: flex; gap: 16px; padding: 0 24px 24px">
    <div style="width: 196px; flex: none; display: flex; flex-direction: column; gap: 10px; overflow: hidden">
      <span style="display: inline-flex; align-items: center; height: 30px; padding: 0 10px; border: 1px solid #e4e4e7; border-radius: 6px; background: #fff; color: #6b6b74">Block types</span>
      {groups.map(([name, items]) => (
        <div style="display: flex; flex-direction: column; gap: 2px">
          <span style="font-size: 12px; color: #6b6b74; padding: 2px 8px">{name}</span>
          {items.map(([n, len, g, sel]) => (
            <span style={`display:flex;align-items:center;gap:8px;height:30px;padding:0 8px;border-radius:8px;background:${sel ? '#eaf1ff' : 'transparent'}`}>
              <span style={`width:8px;height:8px;border-radius:2px;flex:none;background:${C[g]}`}></span>
              <span style="flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-weight: 500">{n}</span>
              <span style={`${mono};font-size:11px;color:#6b6b74`}>{len}</span>
            </span>
          ))}
        </div>
      ))}
    </div>
    <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; border: 1px solid #e4e4e7; border-radius: 10px; background: #fff; overflow: hidden">
      <div style="height: 36px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 12px; background: #f4f4f5; border-bottom: 1px solid #e4e4e7; color: #52525b">
        <span style="font-weight: 500; color: #18181b">Autumn schedule</span><span>2 Nov – 20 Dec 2026</span>
        <span style="display: inline-flex; align-items: center; height: 20px; padding: 0 6px; border-radius: 4px; background: #e8f6ec; color: #15803d; font-size: 11px; font-weight: 500">In use</span>
      </div>
      <div style="height: 32px; flex: none; display: grid; grid-template-columns: 52px repeat(7, minmax(0, 1fr)); border-bottom: 1px solid #e4e4e7">
        <span></span>
        {days.map((d) => <span style="display: flex; align-items: center; gap: 6px; padding: 0 8px; border-left: 1px solid #f0f0f2; font-weight: 500">{d.label}<span style="color: #6b6b74; font-weight: 400">{d.date}</span></span>)}
      </div>
      <div style="flex: 1; min-height: 0; padding: 10px 0">
        <div style="position: relative; height: 100%; display: grid; grid-template-columns: 52px repeat(7, minmax(0, 1fr))">
          <div style="position: relative">
            {hours.map((h) => <span style={`position:absolute;right:8px;top:${h.top};transform:translateY(-50%);${mono};font-size:10.5px;color:#6b6b74`}>{h.label}</span>)}
          </div>
          {days.map((d) => (
            <div style="position: relative; border-left: 1px solid #f0f0f2; background-image: repeating-linear-gradient(to bottom, #f0f0f2 0 1px, transparent 1px 5.5556%)">
              {d.blocks.map((b) => (
                <div style={`position:absolute;left:3px;right:3px;box-sizing:border-box;padding:3px 6px;border-radius:6px;overflow:hidden;display:flex;flex-direction:column;font-size:11px;line-height:1.3;${b.style}`}>
                  {b.showName && <span style="font-weight: 500; overflow: hidden; white-space: nowrap; text-overflow: ellipsis">{b.name}</span>}
                  {b.showTime && <span style={`${mono};font-size:10px;color:#52525b`}>{b.time}</span>}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
    <div style="width: 268px; flex: none; display: flex; flex-direction: column; border: 1px solid #e4e4e7; border-radius: 10px; background: #fff; overflow: hidden">
      <div style="height: 48px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 12px 0 16px; border-bottom: 1px solid #f0f0f2">
        <span style="width: 10px; height: 10px; border-radius: 3px; background: #ea580c"></span>
        <span style="flex: 1; font-weight: 600; font-size: 15px">Prime Drama</span>
        <span style="display: inline-flex; color: #6b6b74" set:html={close} />
      </div>
      <div style="padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; border-bottom: 1px solid #f0f0f2">
        <span style="display: flex; justify-content: space-between"><span style="color: #52525b">Block group</span><span>Prime time</span></span>
        <span style="display: flex; justify-content: space-between; align-items: center"><span style="color: #52525b">Days</span>
          <span style="display: flex; gap: 3px">{['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((l, i) => <span style={`width:22px;height:22px;border-radius:5px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:500;background:${i < 5 ? '#2563eb' : '#f4f4f5'};color:${i < 5 ? '#fff' : '#6b6b74'}`}>{l}</span>)}</span>
        </span>
        <span style="display: flex; justify-content: space-between"><span style="color: #52525b">Start</span><span style={mono}>20:00:00:00</span></span>
        <span style="display: flex; justify-content: space-between"><span style="color: #52525b">End</span><span style={mono}>22:00:00:00</span></span>
        <span style="display: flex; justify-content: space-between"><span style="color: #52525b">Length</span><span style={mono}>02:00:00:00</span></span>
      </div>
      <div style="padding: 14px 16px; display: flex; flex-direction: column; gap: 8px">
        <span style="display: flex; justify-content: space-between; align-items: baseline"><span style="font-weight: 600">Linked breaks</span><span style="font-size: 12px; color: #6b6b74">from the ads template</span></span>
        <div style="border: 1px solid #e4e4e7; border-radius: 8px; overflow: hidden">
          {[['Break 1', '20:14:00:00'], ['Break 2', '20:43:00:00'], ['Break 3', '21:28:00:00']].map(([n, at]) => (
            <span style="display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 10px; border-bottom: 1px solid #f0f0f2"><span style="width: 8px; height: 8px; border-radius: 2px; background: #ea580c"></span><span style="flex: 1">{n}</span><span style={`${mono};font-size:12px;color:#52525b`}>{at}</span></span>
          ))}
        </div>
        <span style="display: inline-flex; align-items: center; height: 22px; align-self: flex-start; padding: 0 8px; border-radius: 4px; background: #eaf1ff; color: #1d4ed8; font-size: 11px; font-weight: 500">Applied to 5 blocks</span>
      </div>
      <span style="flex: 1"></span>
      <div style="padding: 12px 16px; border-top: 1px solid #f0f0f2; display: flex; gap: 8px">
        <span style="display: inline-flex; align-items: center; height: 32px; padding: 0 12px; border-radius: 6px; border: 1px solid #d4d4d8; font-weight: 500">Edit block</span>
        <span style="display: inline-flex; align-items: center; height: 32px; padding: 0 12px; color: #b91c1c; font-weight: 500">Remove</span>
      </div>
    </div>
  </div>
</ShotFrame>
