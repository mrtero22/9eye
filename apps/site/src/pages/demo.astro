---
import Base from '../layouts/Base.astro';
import FormResult from '../components/FormResult.astro';
import Icon from '../components/Icon.astro';
import { BRAND } from '../site';

const KINDS = ['Series and entertainment', 'Film', 'Music', 'News', 'Sport and live', 'Kids', 'FAST and streaming', 'Public media'];
const CHANNELS = [['1', '1'], ['2-5', '2 – 5'], ['6-20', '6 – 20'], ['20+', 'More than 20']];
---
<Base
  title={`Request a Demo | ${BRAND}`}
  description="See AI-powered broadcast scheduling on a channel like yours. Tell us about your channels and we set up a demo."
>
  <div class="container split" style="padding-top: clamp(56px, 7vw, 72px); gap: 56px">
    <div class="stack" style="--gap: 24px; flex-basis: 380px">
      <h1 class="h1 h1--page">Request a demo</h1>
      <p class="lead">See {BRAND} running a channel like yours. Tell us a little about your channels, and we reply by e-mail to set a time.</p>
      <div class="stack" style="--gap: 14px; padding-top: 8px">
        <h2 style="margin: 0; font-size: 15px; font-weight: 600">In the demo</h2>
        <ul class="ticks">
          {['A walk-through on a channel set up like yours', 'How your playout, MAM and current system connect', 'The AI agents in preview', 'Early-access pricing and next steps'].map((t) => (
            <li><Icon name="check" stroke={2} style="color: var(--accent)" />{t}</li>
          ))}
        </ul>
      </div>
      <p class="meta" style="margin: 0; font-size: 14px">We use these details only to answer your request. See the <a href="/privacy">privacy policy</a>.</p>
    </div>

    <div class="form-box" data-form-box style="flex-basis: 520px">
      <form class="form" data-subject={`Demo request – ${BRAND}`}>
        <div class="fields">
          <div class="field"><label for="d-name">Full name</label><input class="input" id="d-name" name="name" type="text" autocomplete="name" required maxlength="200" /></div>
          <div class="field"><label for="d-email">Work e-mail</label><input class="input" id="d-email" name="email" type="email" autocomplete="email" required maxlength="200" /></div>
          <div class="field"><label for="d-company">Company</label><input class="input" id="d-company" name="Company" type="text" autocomplete="organization" required maxlength="200" /></div>
          <div class="field"><label for="d-country">Country</label><input class="input" id="d-country" name="Country" type="text" autocomplete="country-name" required maxlength="100" /></div>
        </div>
        <div class="field">
          <label for="d-role">Your role</label>
          <select class="input" id="d-role" name="Role">
            <option value="">Choose one</option>
            <option>Scheduling or programming</option>
            <option>Traffic or ad operations</option>
            <option>Playout or master control</option>
            <option>Technology</option>
            <option>Management</option>
            <option>Other</option>
          </select>
        </div>
        <fieldset>
          <legend>How many channels?</legend>
          <div class="options" style="--min: 110px">
            {CHANNELS.map(([value, label]) => <label class="opt"><input type="radio" name="Channels" value={value} />{label}</label>)}
          </div>
        </fieldset>
        <fieldset>
          <legend>What kind of channels? <span class="optional">Pick any</span></legend>
          <div class="options">
            {KINDS.map((k) => <label class="opt"><input type="checkbox" name="Channel types" value={k} />{k}</label>)}
          </div>
        </fieldset>
        <div class="field"><label for="d-current">Current scheduling system <span class="optional">Optional</span></label><input class="input" id="d-current" name="Current system" type="text" maxlength="200" /></div>
        <div class="field"><label for="d-message">Anything else we should know? <span class="optional">Optional</span></label><textarea class="input" id="d-message" name="Message" rows="4" maxlength="4000"></textarea></div>
        <div class="hp" aria-hidden="true"><label for="d-botcheck">Leave empty</label><input id="d-botcheck" name="botcheck" type="text" tabindex="-1" autocomplete="off" /></div>
        <label class="consent"><input type="checkbox" name="Consent" value="yes" required />I agree that {BRAND} may contact me about this request.</label>
        <button class="btn btn--primary btn--block" type="submit">Request a demo</button>
      </form>
      <FormResult title="Thank you. Your request is in." text="We reply to your work e-mail to set a time for the demo." again="Send another request" />
    </div>
  </div>
</Base>

<script>
  import '../scripts/forms.ts';
</script>
