---
// Every page: head (title, description, canonical, social cards, structured data), header, footer.
// Pages are indexable only with SITE_URL (the domain) and SITE_INDEX=1 (the user opens the site to search engines).
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BRAND } from '../site';
import { organization } from '../seo';

interface Props {
  title: string;
  description: string;
  current?: string;
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, current, jsonLd = [], noindex = false } = Astro.props;
const site = Astro.site;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = site ? new URL(path, site).href : undefined;
const ogImage = site ? new URL('/og.png', site).href : '/og.png';
const indexable = Boolean(site) && process.env.SITE_INDEX === '1' && !noindex;
const data = [organization(site), ...jsonLd];
const json = (value: object) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {data.map((d) => <script is:inline type="application/ld+json" set:html={json(d)} />)}
  </head>
  <body>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
